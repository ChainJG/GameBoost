<UserControl
    x:Class="GameBoost.MVVM.UserControls.Storage.StorageFolderRowUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Height="40"
    Margin="0,0,0,5"
    d:Width="400"
    mc:Ignorable="d">

    <ContentControl
        ClipToBounds="False"
        Cursor="Hand"
        Style="{StaticResource GameBoostProgressBorderStyle}"
        Tag="{Binding PercentageOfParent, Mode=OneTime}">

        <Grid Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">

                <materialDesign:PackIcon
                    Width="18"
                    Height="18"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource IconKindColor}"
                    Kind="{Binding Icon}" />

                <StackPanel>
                    <TextBlock Style="{StaticResource ButtonTitleStyle}" Text="{Binding Name}" />

                    <TextBlock
                        MaxWidth="320"
                        Foreground="{StaticResource PlainSubtitleTextColor}"
                        Text="{Binding FullPath}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Style="{StaticResource ButtonTitleStyle}"
                Text="{Binding SizeText, FallbackValue='0 GB'}" />

            <TextBlock
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{StaticResource PlainSubtitleTextColor}"
                Text="{Binding PercentageText, FallbackValue='0%'}" />
        </Grid>
    </ContentControl>
</UserControl>