<UserControl
    x:Class="GameBoost.MVVM.UserControls.Storage.StorageFolderRowUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameBoost.MVVM.AttachedProperties"
    Height="40"
    Margin="0,0,0,5"
    d:Width="500"
    mc:Ignorable="d">


    <ContentControl
        x:Name="Root"
        Cursor="Hand"
        Foreground="{StaticResource ButtonIsChecked}"
        Style="{StaticResource GameBoostProgressBorderStyle}"
        Tag="{Binding PercentageOfParent, Mode=OneTime}">

        <Grid Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">

                <materialDesign:PackIcon
                    Width="18"
                    Height="18"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource IconKindColor}"
                    Kind="{Binding Icon, FallbackValue=Folder}" />

                <StackPanel Orientation="Vertical">
                    <TextBlock
                        HorizontalAlignment="Left"
                        Style="{StaticResource ButtonTitleStyle}"
                        Text="{Binding Name, FallbackValue='Folder'}" />

                    <TextBlock
                        MaxWidth="320"
                        HorizontalAlignment="Left"
                        Style="{StaticResource ButtonSubTitleStyle}"
                        Text="{Binding FullPath, FallbackValue='Folder Path'}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Command="{Binding OpenFolderCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="Folder"
                    ToolTip="Open File Explorer" />
                <Button
                    Command="{Binding DeleteFolderCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="Delete"
                    ToolTip="Delete Folder" />
            </StackPanel>

            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Style="{StaticResource ButtonTitleStyle}"
                Text="{Binding SizeText, FallbackValue='0 GB'}" />

            <TextBlock
                Grid.Column="2"
                HorizontalAlignment="Right"
                Style="{StaticResource ButtonSubTitleStyle}"
                Text="{Binding PercentageText, FallbackValue='0%'}" />
        </Grid>
    </ContentControl>
</UserControl>