<UserControl
    x:Class="GameBoost.MVVM.UserControls.Shared.Selection.SelectionUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:actionCards="clr-namespace:GameBoost.MVVM.UserControls.Shared.Selection.Cards.Actions"
    xmlns:actions="clr-namespace:GameBoost.MVVM.ViewModels.Shared.Selection.Cards.Actions"
    xmlns:behaviours="clr-namespace:GameBoost.MVVM.Behaviors"
    xmlns:cards="clr-namespace:GameBoost.MVVM.UserControls.Shared.Selection.Cards"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameBoost.MVVM.AttachedProperties"
    xmlns:viewModels="clr-namespace:GameBoost.MVVM.ViewModels.Shared.Selection"
    d:DataContext="{d:DesignInstance Type=viewModels:SelectionViewModel}"
    d:DesignHeight="700"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <Grid x:Name="PageRoot" ui:VisualStateAssist.State="{Binding DisplayScreenType}">
        <Grid>
            <!--#region Selection Layer-->
            <Grid x:Name="SelectionLayer">

                <Grid.RenderTransform>
                    <TranslateTransform x:Name="SelectionTransform" />
                </Grid.RenderTransform>

                <!--#region Column & Row Definitions-->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--#endregion-->

                <!--#region Page Title-->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource TitleStyle}"
                    Text="{Binding PageTitle}" />
                <!--#endregion-->


                <!--#region Feature Cards ListBox-->

                <ListBox
                    Grid.Row="1"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    ItemContainerStyle="{StaticResource CleanListBoxItemStyle}"
                    ItemsSource="{Binding FeatureCards}"
                    SelectedItem="{Binding SelectedFeatureCard}">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <cards:SelectionFeatureCardUserControl />
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <!--#endregion-->

                <!--#region Selected Feature Title & Description-->
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    Orientation="Vertical">
                    <TextBlock
                        HorizontalAlignment="Left"
                        Style="{StaticResource TitleStyle}"
                        Text="{Binding SelectedFeatureCard.Title}" />
                    <TextBlock
                        HorizontalAlignment="Left"
                        Style="{StaticResource SubTitleStyle}"
                        Text="{Binding SelectedFeatureCard.Description}"
                        TextAlignment="Left"
                        TextWrapping="Wrap" />
                </StackPanel>
                <!--#endregion-->

                <Grid
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    behaviours:PulsePopBehavior.Duration=".5"
                    behaviours:PulsePopBehavior.Overshoot="4.3"
                    behaviours:PulsePopBehavior.ReplayOnChange="{Binding SelectedFeatureCard.Title}"
                    behaviours:PulsePopBehavior.StartScale=".4">
                    <!--#region Feature Watermark-->
                    <materialDesign:PackIcon
                        Width="200"
                        Height="200"
                        Kind="{Binding SelectedFeatureCard.Icon}"
                        Style="{StaticResource WatermarkStyle}" />
                    <!--#endregion-->
                </Grid>

                <!--#region Action Cards ListBox-->
                <ListBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,0,0,30"
                    ItemContainerStyle="{StaticResource CleanListBoxItemStyle}"
                    ItemsSource="{Binding SelectedFeatureCard.Actions}">


                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Margin="0 0 0 0" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <!--#endregion-->

            </Grid>
            <!--#endregion-->

            <!--#region Execution Layer-->
            <Grid x:Name="ExecutionLayer">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ExecutionTransform" X="1200" />
                </Grid.RenderTransform>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.RowSpan="2" Grid.Column="0">
                    <ProgressBar
                        Width="244"
                        Height="244"
                        behaviours:ProgressBarAnimationBehavior.SmoothValue="{Binding ExecutionProgressPercentage}"
                        Foreground="{StaticResource ProgressFillColour}"
                        Maximum="100"
                        Minimum="0"
                        Style="{StaticResource MaterialDesignCircularProgressBar}" />
                    <Ellipse
                        Width="240"
                        Height="240"
                        Fill="{StaticResource SecondaryPanelColour}" />
                    <materialDesign:PackIcon
                        Width="100"
                        Height="100"
                        behaviours:OrbitBehavior.IsOrbiting="True"
                        behaviours:OrbitBehavior.Radius="15"
                        behaviours:OrbitBehavior.Speed="2"
                        Kind="{Binding SelectedExecutionCard.Icon, FallbackValue=QuestionMark}"
                        Style="{StaticResource WatermarkStyle}" />
                    <TextBlock
                        FontSize="60"
                        Style="{StaticResource TitleStyle}"
                        Text="{Binding ExecutionProgressText}" />
                </Grid>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    Style="{StaticResource TitleStyle}"
                    Text="{Binding ExecutionTitleText}" />

                <materialDesign:PackIcon
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Width="300"
                    Height="300"
                    Kind="{Binding SelectedFeatureCard.Icon, FallbackValue=QuestionMark}"
                    Style="{StaticResource WatermarkStyle}" />

                <!--#region Result Cards-->
                <ListBox
                    Grid.Row="1"
                    Grid.Column="1"
                    ItemContainerStyle="{StaticResource CleanListBoxItemStyle}"
                    ItemsSource="{Binding ResultCards}">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <cards:SelectionResultCardUserControl />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!--#endregion-->
            </Grid>
            <!--#endregion-->

            <!--#region Result Layer-->
            <Grid x:Name="ResultLayer">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ResultTransform" X="1200" />
                </Grid.RenderTransform>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--#region Active Execution Card Icon & Title-->
                <Grid Grid.RowSpan="2" Grid.Column="0">
                    <Ellipse
                        Width="240"
                        Height="240"
                        Fill="{StaticResource SecondaryPanelColour}" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        behaviours:PulsePopBehavior.Duration="1"
                        behaviours:PulsePopBehavior.Overshoot="1.5"
                        behaviours:PulsePopBehavior.ReplayOnChange="{Binding SelectedExecutionCard.Title}"
                        behaviours:PulsePopBehavior.StartScale="0"
                        Orientation="Vertical">
                        <materialDesign:PackIcon
                            Width="100"
                            Height="100"
                            Kind="{Binding SelectedExecutionCard.Icon, FallbackValue=QuestionMark}" />
                        <TextBlock
                            MaxWidth="190"
                            Margin="0,10,0,0"
                            FontSize="20"
                            Style="{StaticResource TitleStyle}"
                            Text="{Binding SelectedExecutionCard.Title}"
                            TextTrimming="WordEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock
                        Margin="-150,0,0,0"
                        HorizontalAlignment="Left"
                        ui:RotationAngleAssist.RotationAngle="-90"
                        FontSize="140"
                        Style="{StaticResource WatermarkTitleStyle}"
                        Text="Results" />
                </Grid>
                <!--#endregion-->

                <!--#region Selected Action Result Info-->
                <Grid
                    Grid.Row="1"
                    Grid.Column="0"
                    Height="170"
                    VerticalAlignment="Bottom">
                    <TextBlock
                        VerticalAlignment="Top"
                        FontSize="35"
                        Style="{StaticResource TitleStyle}"
                        Text="{Binding SelectedResultSummary}" />
                    <TextBlock
                        Margin="0,50,0,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource SubTitleStyle}"
                        Text="{Binding SelectedResultOutput}" />
                </Grid>
                <!--#endregion-->

                <!--#region Result Title & Description-->
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    Orientation="Vertical">
                    <TextBlock Style="{StaticResource TitleStyle}" Text="{Binding ResultTitleText}" />
                    <TextBlock
                        HorizontalAlignment="Left"
                        Style="{StaticResource SubTitleStyle}"
                        Text="Select and investigate further to understand the result" />
                </StackPanel>
                <!--#endregion-->

                <!--#region Result Cards-->
                <ListBox
                    Grid.Row="1"
                    Grid.Column="1"
                    ItemContainerStyle="{StaticResource CleanListBoxItemStyle}"
                    ItemsSource="{Binding ResultCards}"
                    SelectedItem="{Binding SelectedExecutionCard}">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <cards:SelectionResultCardUserControl Cursor="Hand" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!--#endregion-->

            </Grid>
            <!--#endregion-->
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DisplayState">

                <VisualState x:Name="Selection">
                    <Storyboard>

                        <!--  Selection visible  -->
                        <DoubleAnimation
                            Storyboard.TargetName="SelectionTransform"
                            Storyboard.TargetProperty="X"
                            To="0"
                            Duration="0:0:0.25" />

                        <!--  Execution off-screen right  -->
                        <DoubleAnimation
                            Storyboard.TargetName="ResultTransform"
                            Storyboard.TargetProperty="X"
                            To="1200"
                            Duration="0:0:0.25" />
                        <!--#endregion-->

                    </Storyboard>
                </VisualState>

                <VisualState x:Name="Execution">
                    <Storyboard>

                        <!--  Selection slides left out  -->
                        <DoubleAnimation
                            Storyboard.TargetName="SelectionTransform"
                            Storyboard.TargetProperty="X"
                            To="-1200"
                            Duration="0:0:0.25" />

                        <!--  Execution slides in  -->
                        <DoubleAnimation
                            Storyboard.TargetName="ExecutionTransform"
                            Storyboard.TargetProperty="X"
                            To="0"
                            Duration="0:0:0.25" />

                    </Storyboard>
                </VisualState>

                <VisualState x:Name="Result">

                    <Storyboard>

                        <DoubleAnimation
                            Storyboard.TargetName="SelectionTransform"
                            Storyboard.TargetProperty="X"
                            To="-1200"
                            Duration="0:0:0.25" />

                        <!--  Execution slides left out  -->
                        <DoubleAnimation
                            Storyboard.TargetName="ExecutionTransform"
                            Storyboard.TargetProperty="X"
                            To="-1200"
                            Duration="0:0:0.25" />

                        <!--  Execution slides in  -->
                        <DoubleAnimation
                            Storyboard.TargetName="ResultTransform"
                            Storyboard.TargetProperty="X"
                            To="0"
                            Duration="0:0:0.25" />
                    </Storyboard>

                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>

    <UserControl.Resources>

        <DataTemplate DataType="{x:Type actions:MultipurposeActionCardViewModel}">
            <actionCards:MultipurposeActionCardUserControl />
        </DataTemplate>

        <DataTemplate DataType="{x:Type actions:ComboBoxActionCardViewModel}">
            <actionCards:ComboBoxActionCardUserControl />
        </DataTemplate>

        <DataTemplate DataType="{x:Type actions:SliderActionCardViewModel}">
            <actionCards:SliderActionCardUserControl />
        </DataTemplate>

    </UserControl.Resources>

</UserControl>
