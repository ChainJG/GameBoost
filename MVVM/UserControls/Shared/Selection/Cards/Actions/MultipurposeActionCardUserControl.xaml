<UserControl
    x:Class="GameBoost.MVVM.UserControls.Shared.Selection.Cards.Actions.MultipurposeActionCardUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:GameBoost.MVVM.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GameBoost.MVVM.UserControls.Shared.Selection.Cards.Actions"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Height="50"
    Margin="0,0,0,5"
    d:Width="400"
    mc:Ignorable="d">

    <ToggleButton IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SelectableActionToggleButtonStyle}">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <CheckBox
                Grid.Column="0"
                Focusable="False"
                IsChecked="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />

            <materialDesign:PackIcon
                Grid.Column="1"
                Width="30"
                Height="30"
                Kind="{Binding Icon, FallbackValue=QuestionMark}" />

            <TextBlock
                Grid.Column="2"
                MaxWidth="240"
                HorizontalAlignment="Left"
                Style="{StaticResource ButtonTitleStyle}"
                Text="{Binding Title, FallbackValue='Module Name'}"
                TextWrapping="Wrap" />

            <Grid
                Grid.Column="2"
                Margin="0,0,10,0"
                HorizontalAlignment="Right">

                <Grid HorizontalAlignment="Right">

                    <materialDesign:PackIcon
                        Width="40"
                        Height="40"
                        Background="Transparent"
                        Kind="{Binding InfoIcon, FallbackValue=HelpRhombus, TargetNullValue=HelpRhombus}"
                        Style="{StaticResource WatermarkStyle}"
                        ToolTip="{Binding InfoToolTip}"
                        Visibility="{Binding InfoToolTip, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Hidden, TargetNullValue=Hidden}" />

                    <materialDesign:PackIcon
                        Width="50"
                        Height="50"
                        Background="Transparent"
                        Kind="CheckAll"
                        Style="{StaticResource WatermarkStyle}"
                        ToolTip="{Binding RecommendationToolTip}"
                        Visibility="{Binding IsRecommendedState, Converter={StaticResource VisibleWhenTrueConverter}, FallbackValue=Hidden, TargetNullValue=Hidden}" />
                </Grid>

                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    IsHitTestVisible="False"
                    Style="{StaticResource ButtonSubTitleStyle}"
                    Text="{Binding Status, FallbackValue='Status'}"
                    TextWrapping="Wrap" />
            </Grid>

        </Grid>
    </ToggleButton>
</UserControl>