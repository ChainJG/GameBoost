<UserControl
    x:Class="GameBoost.MVVM.UserControls.Shared.Selection.Cards.Actions.SliderActionCardUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GameBoost.MVVM.UserControls.Shared.Selection.Cards.Actions"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameBoost.MVVM.AttachedProperties"
    Height="50"
    Margin="0,0,0,5"
    d:Width="500"
    mc:Ignorable="d">


    <ToggleButton IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SelectableActionToggleButtonStyle}">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <materialDesign:PackIcon
                Grid.Column="1"
                Width="30"
                Height="30"
                Kind="{Binding Icon, FallbackValue=QuestionMark}" />

            <TextBlock
                Grid.Column="2"
                Margin="0,0,0,0"
                HorizontalAlignment="Left"
                Style="{StaticResource ButtonTitleStyle}"
                Text="{Binding Title}" />

            <Slider
                Grid.Column="2"
                Width="200"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                ui:RecommendationAssist.IsRecommended="{Binding IsRecommendedState}"
                ui:RecommendationAssist.RecommendationToolTip="{Binding RecommendationToolTip}"
                ui:RecommendationAssist.RecommendedValue="{Binding RecommendedValue}"
                IsSnapToTickEnabled="True"
                Maximum="{Binding Maximum, FallbackValue=100}"
                Minimum="{Binding Minimum, FallbackValue=0}"
                Style="{StaticResource GameBoostSliderWithRecommendedGhostThumbStyle}"
                Tag="{Binding ValueText}"
                TickFrequency="{Binding TickFrequency}"
                Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=50}" />

        </Grid>
    </ToggleButton>
</UserControl>
