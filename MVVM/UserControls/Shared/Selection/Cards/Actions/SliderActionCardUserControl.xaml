<UserControl
    x:Class="GameBoost.MVVM.UserControls.Shared.Selection.Cards.Actions.SliderActionCardUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GameBoost.MVVM.UserControls.Shared.Selection.Cards.Actions"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Height="50"
    d:Width="400"
    mc:Ignorable="d">


    <ToggleButton IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SelectableActionToggleButtonStyle}">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <materialDesign:PackIcon
                Grid.Column="1"
                Width="30"
                Height="30"
                Kind="{Binding Icon, FallbackValue=QuestionMark}" />

            <TextBlock
                Grid.Column="2"
                Margin="0,0,0,0"
                HorizontalAlignment="Left"
                Style="{StaticResource ButtonTitleStyle}"
                Text="{Binding Title}" />

            <Slider
                Grid.Column="3"
                Grid.ColumnSpan="2"
                Width="190"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsSnapToTickEnabled="True"
                Maximum="{Binding Maximum}"
                Minimum="{Binding Minimum}"
                Style="{StaticResource GameBoostSliderStyle}"
                Tag="{Binding ValueText}"
                TickFrequency="{Binding TickFrequency}"
                Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        </Grid>
    </ToggleButton>
</UserControl>
