<UserControl
    x:Class="GameBoost.MVVM.UserControls.Shared.Selection.Cards.Actions.ComboBoxActionCardUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GameBoost.MVVM.UserControls.Shared.Selection.Cards.Actions"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Padding="5"
    mc:Ignorable="d">

    <ToggleButton
        Height="50"
        IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        Style="{StaticResource SelectableActionToggleButtonStyle}">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <CheckBox
                Grid.Column="0"
                Width="20"
                Height="20"
                IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />


            <materialDesign:PackIcon
                Grid.Column="1"
                Width="30"
                Height="30"
                Kind="{Binding Icon, FallbackValue=QuestionMark}" />


            <TextBlock
                Grid.Column="2"
                HorizontalAlignment="Left"
                Style="{StaticResource ButtonTitleStyle}"
                Text="{Binding Title}" />

            <ComboBox
                Grid.Column="3"
                Grid.ColumnSpan="2"
                Height="40"
                Margin="0,0,5,0"
                DisplayMemberPath="DisplayText"
                ItemsSource="{Binding Options}"
                SelectedItem="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource GameBoostComboBoxStyle}" />

        </Grid>


    </ToggleButton>
</UserControl>
