<UserControl
    x:Class="GameBoost.MVVM.UserControls.Shared.Selection.Cards.SelectionFeatureCardUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameBoost.MVVM.AttachedProperties"
    Width="140"
    Height="140"
    Padding="4"
    mc:Ignorable="d">

    <Border
        Padding="10"
        ui:InteractiveCardAssist.IsSelected="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsSelected}"
        ui:InteractiveCardAssist.PressedBorderBrush="Transparent"
        ui:InteractiveCardAssist.SelectedBorderBrush="Transparent"
        Style="{StaticResource GameBoostInteractiveButtonCardBorderStyle}">

        <Grid>
            <CheckBox
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="Visible" />

            <materialDesign:PackIcon
                Width="80"
                Height="80"
                Kind="{Binding Icon, FallbackValue=QuestionMark}"
                Style="{StaticResource WatermarkStyle}" />

            <TextBlock
                MaxWidth="110"
                Style="{StaticResource ButtonTitleStyle}"
                Text="{Binding Title, FallbackValue='Title'}" />

        </Grid>
    </Border>
</UserControl>
