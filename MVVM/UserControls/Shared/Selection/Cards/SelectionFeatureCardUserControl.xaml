<UserControl
    x:Class="GameBoost.MVVM.UserControls.Shared.Selection.Cards.SelectionFeatureCardUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="130"
    Height="130"
    Margin="0,0,5,0"
    mc:Ignorable="d">

    <Border Padding="10" Style="{StaticResource SelectionFeatureCardBorderStyle}">

        <Grid>
            <CheckBox
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="Visible" />

            <materialDesign:PackIcon
                Width="70"
                Height="70"
                Kind="{Binding Icon, FallbackValue=QuestionMark}"
                Style="{StaticResource WatermarkStyle}" />

            <TextBlock
                Style="{StaticResource ButtonTitleStyle}"
                Text="{Binding Title}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />

        </Grid>
    </Border>
</UserControl>
