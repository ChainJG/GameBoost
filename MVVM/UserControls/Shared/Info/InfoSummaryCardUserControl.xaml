<UserControl
    x:Class="GameBoost.MVVM.UserControls.Shared.Info.InfoSummaryCardUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Width="150"
    Height="150"
    Padding="5">

    <Border
        Padding="15"
        Background="{StaticResource ButtonBackground}"
        BorderBrush="{StaticResource ButtonMouseOver}"
        BorderThickness="1"
        CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <StackPanel
                Grid.Row="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Orientation="Horizontal">

                <materialDesign:PackIcon
                    Width="15"
                    Height="15"
                    Foreground="{StaticResource IconKindColor}"
                    Kind="{Binding Icon, FallbackValue=QuestionMark}" />

                <TextBlock
                    MaxWidth="95"
                    Margin="5,0,0,0"
                    Style="{StaticResource ButtonSubTitleStyle}"
                    Text="{Binding Title, FallbackValue='Title'}"
                    TextTrimming="CharacterEllipsis" />

            </StackPanel>

            <!--  Main information  -->
            <TextBlock
                Grid.Row="1"
                MaxWidth="120"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Style="{StaticResource ButtonTitleStyle}"
                Text="{Binding Info, FallbackValue='Infomation'}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />

            <!--  Footer  -->
            <TextBlock
                Grid.Row="2"
                MaxWidth="120"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Style="{StaticResource ButtonSubTitleStyle}"
                Text="{Binding Footer, FallbackValue='Footer text'}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />

        </Grid>
    </Border>
</UserControl>