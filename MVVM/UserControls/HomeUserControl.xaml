<UserControl
    x:Class="GameBoost.MVVM.UserControls.HomeUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviours="clr-namespace:GameBoost.MVVM.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:info="clr-namespace:GameBoost.MVVM.UserControls.Shared.Info"
    xmlns:local="clr-namespace:GameBoost.MVVM.UserControls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameBoost.MVVM.AttachedProperties"
    xmlns:viewModels="clr-namespace:GameBoost.MVVM.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:HomeViewModel}"
    d:DesignHeight="560"
    d:DesignWidth="1025"
    mc:Ignorable="d">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="240" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Cards  -->
        <Grid Grid.Row="0">

            <Expander Header="Hardware" Style="{StaticResource GameBoostLockedExpanderStyle}">

                <!--#region Hardware Cards-->
                <ItemsControl ItemsSource="{Binding HardwareCards}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Margin="0,0,0,0" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <info:InfoSummaryCardUserControl />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!--#endregion-->

            </Expander>
        </Grid>

        <!--  Cards  -->
        <Grid
            Grid.Row="1"
            Margin="0,10,0,0"
            VerticalAlignment="Top">

            <Expander Header="Recommended Tweaks" Style="{StaticResource GameBoostExpanderStyle}">

                <ItemsControl ItemsSource="{Binding RecommendedActions}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Margin="0,0,0,0" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <info:InfoSummaryCardUserControl />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </Expander>
        </Grid>

    </Grid>
</UserControl>