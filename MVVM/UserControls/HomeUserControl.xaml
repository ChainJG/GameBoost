<UserControl
    x:Class="GameBoost.MVVM.UserControls.HomeUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:info="clr-namespace:GameBoost.MVVM.UserControls.Shared.Info"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:GameBoost.MVVM.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:HomeViewModel}"
    d:DesignHeight="560"
    d:DesignWidth="1025"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--#region Main Title-->
            <Grid Grid.Row="0" Margin="0,0,0,10">

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TitleStyle}" Text="Home" />

                    <TextBlock Style="{StaticResource SubTitleStyle}" Text="A clean overview of your PC, recommended tweaks, and useful optimisation checks for gaming-focused systems" />
                </StackPanel>
            </Grid>
            <!--#endregion-->

            <!--#region Hardware-->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--#region Title-->
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,15"
                    Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        Margin="0,0,8,0"
                        Foreground="{StaticResource IconKindColor}"
                        Kind="DesktopTowerMonitor" />

                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Hardware" />
                </StackPanel>
                <!--#endregion-->

                <!--#region Info Cards-->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding HardwareCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <info:InfoSummaryCardUserControl />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!--#endregion-->
            </Grid>
            <!--#endregion-->

            <!--#region Recommended Optimisations-->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <!--#region Title-->
                    <StackPanel
                        Margin="0,0,0,15"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,8,0"
                            Foreground="{StaticResource IconKindColor}"
                            Kind="TuneVariant" />

                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Recommended Optimisations" />
                    </StackPanel>
                    <!--#endregion-->

                </Grid>

                <!--#region Info Cards-->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding RecommendedActions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <info:InfoSummaryCardUserControl />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!--#endregion-->
            </Grid>
            <!--#endregion-->

            <!--#region Recommended Action Count-->
            <Border
                Grid.Row="3"
                Margin="0,0,0,15"
                Padding="15,10"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Style="{StaticResource GameBoostButtonCardBorderStyle}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Icon  -->
                    <materialDesign:PackIcon
                        x:Name="RecommendedStateIcon"
                        Grid.Column="0"
                        Width="18"
                        Height="18"
                        Margin="0,0,8,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">

                        <materialDesign:PackIcon.Style>
                            <Style TargetType="{x:Type materialDesign:PackIcon}">
                                <Setter Property="Foreground" Value="{StaticResource WarningColour}" />
                                <Setter Property="Kind" Value="LightbulbOnOutline" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecommendedActions.Count}" Value="0">
                                        <Setter Property="Foreground" Value="{StaticResource RecommendedColour}" />
                                        <Setter Property="Kind" Value="CheckCircleOutline" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">

                        <!--  Main title  -->
                        <TextBlock>
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource SubTitleStyle}" TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{StaticResource PlainTitleTextColor}" />
                                    <Setter Property="Text" Value="{Binding RecommendedActions.Count, StringFormat={}{0} recommended actions, FallbackValue='0 recommended actions'}" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecommendedActions.Count}" Value="0">
                                            <Setter Property="Text" Value="System looks optimised" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!--  Subtitle  -->
                        <TextBlock FontSize="10">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource ButtonSubTitleStyle}" TargetType="{x:Type TextBlock}">

                                    <Setter Property="Text" Value="Review suggested improvements" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecommendedActions.Count}" Value="0">
                                            <Setter Property="Text" Value="No recommended changes found" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
            <!--#endregion-->

        </Grid>
    </ScrollViewer>
</UserControl>