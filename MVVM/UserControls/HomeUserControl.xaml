<UserControl
    x:Class="GameBoost.MVVM.UserControls.HomeUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:info="clr-namespace:GameBoost.MVVM.UserControls.Shared.Info"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:GameBoost.MVVM.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:HomeViewModel}"
    d:DesignHeight="560"
    d:DesignWidth="1025"
    mc:Ignorable="d">

    <UserControl.Resources>

        <Style
            x:Key="HomeSectionPanelStyle"
            BasedOn="{StaticResource GameBoostBaseBorderStyle}"
            TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="HomeSectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource PlainTitleTextColor}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HomeSectionSubtitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource PlainSubtitleTextColor}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HomeSectionIconStyle" TargetType="{x:Type materialDesign:PackIcon}">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Foreground" Value="{StaticResource IconKindColor}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header / Hero  -->
            <Border Grid.Row="0" Style="{StaticResource HomeSectionPanelStyle}">

                <Grid>
                    <Image
                        Width="50"
                        Height="50"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Source="/Assets/Images/1024_GameBoost_Logo_Default.png" />

                    <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                        <TextBlock Style="{StaticResource TitleStyle}" Text="Home" />
                        <TextBlock
                            Margin="0,5,0,0"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource PlainSubtitleTextColor}"
                            Text="Review your hardware, apply recommended optimisations, and keep your gaming setup clean." />
                    </StackPanel>

                    <Border
                        Padding="12,7"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource GameBoostInfoCardBorderStyle}">

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="15"
                                Height="15"
                                Margin="0,0,6,0"
                                Foreground="{StaticResource WarningColour}"
                                Kind="LightbulbOnOutline" />

                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource PlainSubtitleTextColor}"
                                Text="{Binding RecommendedActions.Count, StringFormat={}{0} recommended}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!--  Hardware  -->
            <Border Grid.Row="1" Style="{StaticResource HomeSectionPanelStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Section header  -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Margin="0,0,8,0"
                                Kind="DesktopTowerMonitor"
                                Style="{StaticResource HomeSectionIconStyle}" />

                            <StackPanel>
                                <TextBlock Style="{StaticResource HomeSectionTitleStyle}" Text="Hardware Overview" />

                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource HomeSectionSubtitleStyle}"
                                    Text="Detected system components and current capacity" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!--  Hardware cards  -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding HardwareCards}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <info:InfoSummaryCardUserControl />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!--  Recommended Tweaks  -->
            <Border Grid.Row="2" Style="{StaticResource HomeSectionPanelStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Section header  -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Margin="0,0,8,0"
                                Kind="TuneVariant"
                                Style="{StaticResource HomeSectionIconStyle}" />

                            <StackPanel>
                                <TextBlock Style="{StaticResource HomeSectionTitleStyle}" Text="Recommended Optimisations" />

                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource HomeSectionSubtitleStyle}"
                                    Text="Suggested changes based on your current Windows and system configuration" />
                            </StackPanel>
                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            Padding="10,5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource GameBoostInfoCardBorderStyle}">

                            <TextBlock Style="{StaticResource HomeSectionSubtitleStyle}" Text="{Binding RecommendedActions.Count, StringFormat={}{0} actions}" />
                        </Border>
                    </Grid>

                    <!--  Recommended cards  -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding RecommendedActions}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <info:InfoSummaryCardUserControl />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>