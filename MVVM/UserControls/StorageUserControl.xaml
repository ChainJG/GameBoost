<UserControl
    x:Class="GameBoost.MVVM.UserControls.StorageUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attach="clr-namespace:GameBoost.MVVM.AttachedProperties"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:display="clr-namespace:GameBoost.MVVM.UserControls.Shared.Display"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:storageViews="clr-namespace:GameBoost.MVVM.UserControls.Storage"
    xmlns:storageVm="clr-namespace:GameBoost.MVVM.ViewModels"
    xmlns:viewModels="clr-namespace:GameBoost.MVVM.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:StorageViewModel}"
    d:DesignHeight="560"
    d:DesignWidth="1025"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--#region Header-->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            VerticalAlignment="Top">

            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TitleStyle}" Text="Storage Analyser" />
                <TextBlock Style="{StaticResource SubTitleStyle}" Text="Find large folders, inspect storage usage, and quickly see where your drive space is going" />
            </StackPanel>

            <!--#region Buttons (Scan, Cancel)-->
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="60"
                    Height="60"
                    HorizontalAlignment="Center"
                    attach:PackIconKindAssist.Kind="MagnifyScan"
                    Command="{Binding ScanCommand}"
                    Content="Scan Drive"
                    Style="{StaticResource InteractiveIconButtonStyle}" />
                <Button
                    Width="60"
                    Height="60"
                    Margin="6,0,0,0"
                    attach:PackIconKindAssist.Kind="Close"
                    Command="{Binding CancelScanCommand}"
                    Content="Cancel"
                    Style="{StaticResource InteractiveIconButtonStyle}" />
            </StackPanel>
            <!--#endregion-->
        </Grid>
        <!--#endregion-->

        <!--#region Drive Panel-->
        <Grid Grid.Row="1">

            <ListBox
                MaxHeight="70"
                ItemContainerStyle="{StaticResource CleanListBoxItemStyle}"
                ItemsSource="{Binding Drives}"
                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                SelectedItem="{Binding SelectedDrive}">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <storageViews:StorageDriveCardUserControl />
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </Grid>
        <!--#endregion-->

        <!--#region Address Bar-->
        <Grid Grid.Row="2">
            <storageViews:StorageBreadcrumbBarUserControl VerticalAlignment="Center" />
        </Grid>
        <!--#endregion-->

        <!--#region Folder List-->
        <Grid Grid.Row="3">

            <!--  Folder list  -->
            <ListBox
                x:Name="FolderListBox"
                ItemContainerStyle="{StaticResource CleanListBoxItemStyle}"
                ItemsSource="{Binding Folders}"
                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                SelectedItem="{Binding SelectedFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <storageViews:StorageFolderRowUserControl />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <!--#endregion-->

        <!--#region Status Text-->
        <Grid
            Grid.Row="3"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom">

            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowDelayedScanningState}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border
                Margin="0,0,0,15"
                Padding="15,5"
                Style="{StaticResource GameBoostButtonCardBorderStyle}">
                <TextBlock Style="{StaticResource SubTitleStyle}" Text="{Binding StatusText}" />
            </Border>
        </Grid>
        <!--#endregion-->

        <!--#region Folder States-->
        <Grid
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <!--#region No Drives Selected State-->
            <display:IconDisplayInfoUserControl
                Title="No drive scanned yet"
                Icon="Harddisk"
                SubTitle="Select a drive above and start a scan to see which folders are using the most space">

                <display:IconDisplayInfoUserControl.Style>
                    <Style TargetType="display:IconDisplayInfoUserControl">
                        <Setter Property="Visibility" Value="Collapsed" />

                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding FolderUiState}" Value="{x:Static storageVm:StorageFolderUiState.Initial}" />
                                    <Condition Binding="{Binding ShowDelayedScanningState}" Value="False" />
                                    <Condition Binding="{Binding HasSelectedDrive}" Value="True" />
                                </MultiDataTrigger.Conditions>

                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </display:IconDisplayInfoUserControl.Style>
            </display:IconDisplayInfoUserControl>
            <!--#endregion-->

            <!--#region No Drives Selected State-->
            <display:IconDisplayInfoUserControl
                Title="No drive selected yet"
                Icon="Harddisk"
                SubTitle="Select a drive above and start a scan to see which folders are using the most space">

                <display:IconDisplayInfoUserControl.Style>
                    <Style TargetType="display:IconDisplayInfoUserControl">
                        <Setter Property="Visibility" Value="Collapsed" />

                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding FolderUiState}" Value="{x:Static storageVm:StorageFolderUiState.Initial}" />
                                    <Condition Binding="{Binding ShowDelayedScanningState}" Value="False" />
                                    <Condition Binding="{Binding HasSelectedDrive}" Value="False" />
                                </MultiDataTrigger.Conditions>

                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </display:IconDisplayInfoUserControl.Style>
            </display:IconDisplayInfoUserControl>
            <!--#endregion-->

            <!--#region Scanning State-->
            <display:IconDisplayInfoUserControl
                Title="Scanning storage"
                Icon="Timelapse"
                SubTitle="{Binding StatusText, StringFormat='{}{0}...'}">

                <display:IconDisplayInfoUserControl.Style>
                    <Style TargetType="display:IconDisplayInfoUserControl">
                        <Setter Property="Visibility" Value="Collapsed" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowDelayedScanningState}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>

                    </Style>
                </display:IconDisplayInfoUserControl.Style>
            </display:IconDisplayInfoUserControl>
            <!--#endregion-->

            <!--#region Empty Folder State-->
            <display:IconDisplayInfoUserControl
                Title="No subfolders found"
                Icon="FolderHidden"
                SubTitle="{Binding CurrentFolderDisplayName, StringFormat='{}{0} has no recurring folders to display'}">

                <display:IconDisplayInfoUserControl.Style>
                    <Style TargetType="display:IconDisplayInfoUserControl">
                        <Setter Property="Visibility" Value="Collapsed" />

                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding FolderUiState}" Value="{x:Static storageVm:StorageFolderUiState.EmptyFolder}" />
                                    <Condition Binding="{Binding ShowDelayedScanningState}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>

                    </Style>
                </display:IconDisplayInfoUserControl.Style>
            </display:IconDisplayInfoUserControl>
            <!--#endregion-->

            <!--#region Failed State-->
            <display:IconDisplayInfoUserControl
                Title="Storage scan failed"
                Icon="AlertCircleOutline"
                SubTitle="GameBoost could not scan this location. Try another folder or run the scan again">

                <display:IconDisplayInfoUserControl.Style>
                    <Style TargetType="display:IconDisplayInfoUserControl">
                        <Setter Property="Visibility" Value="Collapsed" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FolderUiState}" Value="{x:Static storageVm:StorageFolderUiState.Failed}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>

                    </Style>
                </display:IconDisplayInfoUserControl.Style>
            </display:IconDisplayInfoUserControl>
            <!--#endregion-->

        </Grid>
        <!--#endregion-->

    </Grid>
</UserControl>