<UserControl
    x:Class="GameBoost.MVVM.UserControls.StorageUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:storageViews="clr-namespace:GameBoost.MVVM.UserControls.Storage"
    xmlns:viewModels="clr-namespace:GameBoost.MVVM.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:StorageViewModel}"
    d:DesignHeight="560"
    d:DesignWidth="1025"
    mc:Ignorable="d">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="15"
            Style="{StaticResource GameBoostBaseBorderStyle}">

            <Grid>
                <materialDesign:PackIcon
                    Width="70"
                    Height="70"
                    Kind="Harddisk"
                    Style="{StaticResource WatermarkStyle}" />
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <StackPanel>
                        <TextBlock Style="{StaticResource TitleStyle}" Text="Storage Analyser" />

                        <TextBlock
                            Margin="0,5,0,0"
                            Foreground="{StaticResource PlainSubtitleTextColor}"
                            Text="Identify which folders and categories are using the most storage." />
                    </StackPanel>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Vertical">

                    <StackPanel Margin="0,0,0,5" Orientation="Horizontal">

                        <Button
                            Command="{Binding ScanCommand}"
                            Content="Scan"
                            Style="{StaticResource DockActionButtonStyle}"
                            Tag="MagnifyScan" />

                        <Button
                            Command="{Binding CancelScanCommand}"
                            Content="Cancel"
                            Style="{StaticResource DockActionButtonStyle}"
                            Tag="Close" />

                    </StackPanel>

                    <TextBlock Foreground="{StaticResource PlainSubtitleTextColor}" Text="{Binding StatusText, FallbackValue='Ready'}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Drive cards placeholder  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="10"
            CornerRadius="18"
            Style="{StaticResource GameBoostBaseBorderStyle}">

            <!--  Drive toggle cards  -->
            <ListBox
                ItemContainerStyle="{StaticResource CleanListBoxItemStyle}"
                ItemsSource="{Binding Drives}"
                SelectedItem="{Binding SelectedDrive}">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <storageViews:StorageDriveCardUserControl />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!--  Main layout  -->
        <Grid Grid.Row="2">
            <!--  Folder browser  -->
            <Border Style="{StaticResource GameBoostBaseBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Background="{StaticResource PrimaryPanelColour}"
                        CornerRadius="10 10 0 0">

                        <storageViews:StorageBreadcrumbBarUserControl Margin="5,0,0,0" VerticalAlignment="Center" />

                    </Border>

                    <ListBox
                        Grid.Row="1"
                        Margin="10"
                        ItemContainerStyle="{StaticResource CleanListBoxItemStyle}"
                        ItemsSource="{Binding Folders}"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        SelectedItem="{Binding SelectedFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <storageViews:StorageFolderRowUserControl />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>