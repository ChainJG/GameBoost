<UserControl
    x:Class="GameBoost.MVVM.UserControls.StorageUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:storageViews="clr-namespace:GameBoost.MVVM.UserControls.Storage"
    xmlns:storageVm="clr-namespace:GameBoost.MVVM.ViewModels"
    xmlns:viewModels="clr-namespace:GameBoost.MVVM.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:StorageViewModel}"
    d:DesignHeight="560"
    d:DesignWidth="1025"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--#region Header-->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Grid.ColumnSpan="3"
                VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TitleStyle}" Text="Storage Analyser" />


                <TextBlock Style="{StaticResource SubTitleStyle}" Text="Find large folders, inspect storage usage, and quickly see where your drive space is going" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    HorizontalAlignment="Center"
                    Command="{Binding ScanCommand}"
                    Content="Scan Drive"
                    Style="{StaticResource InteractiveIconButtonStyle}"
                    Tag="MagnifyScan" />
                <Button
                    Margin="6,0,0,0"
                    Command="{Binding CancelScanCommand}"
                    Content="Cancel"
                    Style="{StaticResource InteractiveIconButtonStyle}"
                    Tag="Close" />
            </StackPanel>
        </Grid>
        <!--#endregion-->

        <!--#region Drive Panel-->
        <Grid Grid.Row="1">

            <ListBox
                MaxHeight="70"
                ItemContainerStyle="{StaticResource CleanListBoxItemStyle}"
                ItemsSource="{Binding Drives}"
                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                SelectedItem="{Binding SelectedDrive}">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <storageViews:StorageDriveCardUserControl />
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </Grid>
        <!--#endregion-->

        <!--#region Address Bar-->
        <Grid Grid.Row="2">
            <storageViews:StorageBreadcrumbBarUserControl VerticalAlignment="Center" />
        </Grid>
        <!--#endregion-->

        <!--#region Folder List-->
        <Grid Grid.Row="3">

            <!--  Folder list  -->
            <ListBox
                x:Name="FolderListBox"
                ItemContainerStyle="{StaticResource CleanListBoxItemStyle}"
                ItemsSource="{Binding Folders}"
                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                SelectedItem="{Binding SelectedFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <storageViews:StorageFolderRowUserControl />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <!--#endregion-->

        <Grid
            Grid.Row="3"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom">

            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowDelayedScanningState}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border
                Margin="0,0,0,15"
                Padding="15,5"
                Style="{StaticResource GameBoostInfoCardBorderStyle}">
                <TextBlock Style="{StaticResource SubTitleStyle}" Text="{Binding StatusText}" />
            </Border>
        </Grid>

        <!--#region Folder States-->
        <Grid
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <!--#region Initial State-->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />

                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding FolderUiState}" Value="{x:Static storageVm:StorageFolderUiState.Initial}" />
                                    <Condition Binding="{Binding ShowDelayedScanningState}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel MaxWidth="430" HorizontalAlignment="Center">
                    <Border
                        Width="76"
                        Height="76"
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        Background="{StaticResource ButtonBackground}"
                        CornerRadius="24">

                        <materialDesign:PackIcon
                            Width="38"
                            Height="38"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource PlainSubtitleTextColor}"
                            Kind="Harddisk" />
                    </Border>

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PlainTitleTextColor}"
                        Text="No drive scanned yet" />

                    <TextBlock
                        Margin="0,6,0,18"
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource PlainSubtitleTextColor}"
                        Text="Select a drive above and start a scan to see which folders are using the most space."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                </StackPanel>
            </Grid>
            <!--#endregion-->

            <!--#region Empty Folder State-->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />

                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding FolderUiState}" Value="{x:Static storageVm:StorageFolderUiState.EmptyFolder}" />
                                    <Condition Binding="{Binding ShowDelayedScanningState}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel MaxWidth="450" HorizontalAlignment="Center">
                    <Border
                        Width="76"
                        Height="76"
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        Background="{StaticResource ButtonBackground}"
                        CornerRadius="24">

                        <materialDesign:PackIcon
                            Width="38"
                            Height="38"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource PlainSubtitleTextColor}"
                            Kind="FolderOpenOutline" />
                    </Border>

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PlainTitleTextColor}"
                        Text="No subfolders found" />

                    <TextBlock
                        Margin="0,6,0,4"
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource PlainSubtitleTextColor}"
                        Text="{Binding CurrentFolderDisplayName, StringFormat='{}{0} has no folders to display.'}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource PlainSubtitleTextColor}"
                        Text="Use the breadcrumb above to go back to a parent folder."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <!--#endregion-->

            <!--#region Scanning State-->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowDelayedScanningState}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel MaxWidth="460" HorizontalAlignment="Center">
                    <Border
                        Width="76"
                        Height="76"
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        Background="{StaticResource ButtonBackground}"
                        CornerRadius="24">

                        <materialDesign:PackIcon
                            Width="38"
                            Height="38"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource PlainSubtitleTextColor}"
                            Kind="ProgressClock" />
                    </Border>

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PlainTitleTextColor}"
                        Text="Scanning storage..." />

                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource PlainSubtitleTextColor}"
                        Text="{Binding StatusText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <!--#endregion-->

            <!--#region Failed State-->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FolderUiState}" Value="{x:Static storageVm:StorageFolderUiState.Failed}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel MaxWidth="430" HorizontalAlignment="Center">
                    <Border
                        Width="76"
                        Height="76"
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        Background="{StaticResource ButtonBackground}"
                        CornerRadius="24">

                        <materialDesign:PackIcon
                            Width="38"
                            Height="38"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource PlainSubtitleTextColor}"
                            Kind="AlertCircleOutline" />
                    </Border>

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PlainTitleTextColor}"
                        Text="Storage scan failed" />

                    <TextBlock
                        Margin="0,6,0,18"
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource PlainSubtitleTextColor}"
                        Text="GameBoost could not scan this location. Try another folder or run the scan again."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <!--#endregion-->

        </Grid>
        <!--#endregion-->

    </Grid>
</UserControl>