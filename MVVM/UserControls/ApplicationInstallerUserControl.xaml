<UserControl
    x:Class="GameBoost.MVVM.UserControls.ApplicationInstallerUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:GameBoost.MVVM.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:info="clr-namespace:GameBoost.MVVM.UserControls.Shared.Info"
    xmlns:infoControls="clr-namespace:GameBoost.MVVM.UserControls.Shared.Info"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameBoost.MVVM.AttachedProperties"
    xmlns:viewModels="clr-namespace:GameBoost.MVVM.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:ApplicationInstallerViewModel}"
    d:DesignHeight="560"
    d:DesignWidth="1025"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--#region Header-->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TitleStyle}" Text="Application Installer" />

                <TextBlock Style="{StaticResource SubTitleStyle}" Text="Select common apps to install automatically through trusted package sources" />
            </StackPanel>
        </Grid>
        <!--#endregion-->



        <!--#region Category Buttons-->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <ListBox
                ItemsSource="{Binding CategoryFilters}"
                SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                SelectionMode="Single"
                Style="{StaticResource SelectCategoryListBoxStyle}" />
        </Grid>
        <!--#endregion-->

        <!--#region Info Cards-->
        <ScrollViewer
            Grid.Row="2"
            Grid.Column="0"
            Margin="10,0,0,30"
            ui:InfiniteScrollAssist.IsEnabled="True"
            ui:InfiniteScrollAssist.LoadMoreCommand="{Binding LoadMoreAppsCommand}"
            ui:InfiniteScrollAssist.ScrollThreshold="180"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Hidden">

            <ItemsControl ItemsSource="{Binding AppCards}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <infoControls:InfoActionCardUserControl MinWidth="190" MinHeight="200" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <!--#endregion-->

        <Grid
            Grid.Row="3"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom">
            <Border
                Margin="0,0,0,15"
                Padding="15,5"
                Style="{StaticResource GameBoostButtonCardBorderStyle}">
                <TextBlock Style="{StaticResource SubTitleStyle}" Text="{Binding StatusText}" />
            </Border>
        </Grid>

    </Grid>
</UserControl>