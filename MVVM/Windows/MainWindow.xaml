<Window
    x:Class="GameBoost.MVVM.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:GameBoost.MVVM.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:GameBoost.MVVM.ViewModels"
    Title="GameBoost"
    Width="1200"
    Height="740"
    d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>
        <materialDesign:Card
            Height="700"
            VerticalAlignment="Top"
            Background="{StaticResource PrimaryPanelColour}"
            UniformCornerRadius="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--#region Title Bar-->
                <Grid
                    Grid.Row="0"
                    Background="{StaticResource SecondaryPanelColour}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Grid.Column="0"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        Opacity=".3">

                        <TextBlock Style="{StaticResource SubTitleStyle}" Text="{Binding AppVersionText}" />

                    </Grid>

                    <!--#region Page Display UI-->
                    <StackPanel
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon Margin="0,0,5,0" Kind="{Binding PageIcon}" />
                        <TextBlock Style="{StaticResource ButtonSubTitleStyle}" Text="{Binding PageTitle}" />

                    </StackPanel>
                    <!--#endregion-->

                    <ItemsControl Grid.Column="0" ItemsSource="{Binding TitleBarActions}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Width="30"
                                    Height="30"
                                    Margin="4,0,0,0"
                                    behaviors:PulsePopBehavior.Duration=".6"
                                    behaviors:PulsePopBehavior.Overshoot="6"
                                    behaviors:PulsePopBehavior.ReplayOnChange="{Binding IsEnabled}"
                                    behaviors:PulsePopBehavior.StartScale=".6"
                                    Command="{Binding Command}"
                                    Foreground="{Binding Foreground}"
                                    IsEnabled="{Binding IsEnabled}"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    Tag="{Binding Icon}"
                                    ToolTip="{Binding Title}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>


                    <Separator
                        Grid.Column="1"
                        Width="15"
                        Height="1.5"
                        Style="{StaticResource VerticalSeparatorStyle}" />

                    <!--#region Application Buttons (Minimise, Exit)-->
                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <Button
                            Background="Transparent"
                            Click="BtnMinimiseWindow_Click"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Tag="WindowMinimize" />

                        <Button
                            Background="Transparent"
                            Click="BtnExitApplication_Click"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Tag="WindowClose" />
                    </StackPanel>
                    <!--#endregion-->

                </Grid>
                <!--#endregion-->

                <!--#region Page Content View-->
                <ContentControl
                    Grid.Row="1"
                    Margin="20,20,20,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Content="{Binding CurrentView}" />
                <!--#endregion-->

                <ProgressBar
                    Grid.Row="1"
                    Height="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    IsIndeterminate="True">

                    <ProgressBar.Style>
                        <Style BasedOn="{StaticResource GameBoostLoopProgressBarStyle}" TargetType="{x:Type ProgressBar}">

                            <Setter Property="Opacity" Value="0" />
                            <Setter Property="Visibility" Value="Hidden" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GlobalOperations.IsGlobalProgressVisible}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>

                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>


            </Grid>
        </materialDesign:Card>

        <Grid
            x:Name="DockRoot"
            Width="580"
            Height="80"
            Margin="0,0,330,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom">
            <!--#region Dock Panel-->

            <Border
                Width="Auto"
                Height="Auto"
                Background="{StaticResource PrimaryPanelColour}"
                CornerRadius="10" />


            <Border
                x:Name="DockLeft"
                Width="70"
                Margin="5"
                HorizontalAlignment="Left"
                Background="{StaticResource SecondaryPanelColour}"
                CornerRadius="7"
                Opacity="1">
                <Button
                    Width="80"
                    Command="{Binding DockActionCommand}"
                    Content="{Binding DockActionText}"
                    Style="{StaticResource DockActionButtonStyle}"
                    Tag="{Binding DockActionIcon}" />
            </Border>

            <!--#region Dock Center-->
            <Border
                x:Name="DockCenter"
                Grid.Column="1"
                Width="500"
                Margin="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="{StaticResource SecondaryPanelColour}"
                CornerRadius="8">
                <Grid>

                    <ListBox
                        ItemsSource="{Binding Pages}"
                        SelectedItem="{Binding SelectedPage}"
                        Style="{StaticResource DockMenuListBoxStyle}" />

                </Grid>
            </Border>
            <!--#endregion-->

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="DockStates">

                    <VisualState x:Name="FullDock">
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="DockRoot"
                                Storyboard.TargetProperty="Width"
                                To="580"
                                Duration="0:0:0.15" />

                            <DoubleAnimation
                                Storyboard.TargetName="DockLeft"
                                Storyboard.TargetProperty="Width"
                                To="80"
                                Duration="0:0:0.15" />

                            <DoubleAnimation
                                Storyboard.TargetName="DockLeft"
                                Storyboard.TargetProperty="Opacity"
                                To="1"
                                Duration="0:0:0.10" />

                            <behaviors:CornerRadiusAnimation
                                Storyboard.TargetName="DockCenter"
                                Storyboard.TargetProperty="CornerRadius"
                                From="10"
                                To="0 10 10 0"
                                Duration="0:0:0.15" />

                        </Storyboard>
                    </VisualState>

                    <VisualState x:Name="CompactDock">
                        <Storyboard>

                            <DoubleAnimation
                                Storyboard.TargetName="DockRoot"
                                Storyboard.TargetProperty="Width"
                                To="510"
                                Duration="0:0:0.15" />

                            <DoubleAnimation
                                Storyboard.TargetName="DockLeft"
                                Storyboard.TargetProperty="Width"
                                To="0"
                                Duration="0:0:0.15" />

                            <behaviors:CornerRadiusAnimation
                                Storyboard.TargetName="DockCenter"
                                Storyboard.TargetProperty="CornerRadius"
                                From="0 10 10 0"
                                To="10"
                                Duration="0:0:0.3" />

                        </Storyboard>
                    </VisualState>

                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
        <!--#endregion-->

    </Grid>

</Window>
