<Window
    x:Class="GameBoost.MVVM.Windows.ProcessLookupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:GameBoost.MVVM.Behaviors"
    xmlns:cards="clr-namespace:GameBoost.MVVM.UserControls.Shared.Selection.Cards.Actions"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GameBoost.MVVM.Windows"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:GameBoost.MVVM.ViewModels"
    Title="Process Lookup"
    Width="550"
    Height="690"
    d:DataContext="{d:DesignInstance Type=viewModels:ProcessLookupViewModel}"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid>

        <materialDesign:Card
            Margin="0,0,0,35"
            Background="{StaticResource AppBackgroundColour}"
            UniformCornerRadius="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--#region Title Bar-->
                <Grid
                    Grid.Row="0"
                    Background="{StaticResource TitleBarBackgroundColour}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>

                    <!--#region GameBoost Logo-->
                    <StackPanel
                        Grid.Column="0"
                        Margin="15,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="Hidden">

                        <materialDesign:PackIcon Margin="0,0,5,0" Kind="Pulse" />
                        <TextBlock Style="{StaticResource SubTitleStyle}" Text="GameBoost" />
                    </StackPanel>
                    <!--#endregion-->


                    <!--#region Page Display UI-->
                    <StackPanel
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <materialDesign:PackIcon Margin="0,0,5,0" Kind="MessageProcessing" />
                        <TextBlock Style="{StaticResource ButtonSubTitleStyle}" Text="Process Lookup" />
                    </StackPanel>
                    <!--#endregion-->

                    <Separator
                        Grid.Column="1"
                        Width="15"
                        Height="1.5"
                        Style="{StaticResource VerticalSeparatorStyle}" />

                    <!--#region Application Buttons (Minimise, Exit)-->
                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <Button
                            Background="Transparent"
                            Click="BtnMinimiseWindow_Click"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Tag="WindowMinimize" />

                        <Button
                            Background="Transparent"
                            Click="BtnExitApplication_Click"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Tag="WindowClose" />
                    </StackPanel>
                    <!--#endregion-->
                </Grid>
                <!--#endregion-->

                <Grid
                    Grid.Row="1"
                    Margin="20,5,20,0"
                    ClipToBounds="False">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ClipToBounds="False">

                        <TextBlock Style="{StaticResource TitleStyle}" Text="Processes using this file" />

                        <TextBlock
                            Margin="0,4,0,0"
                            Background="Transparent"
                            ClipToBounds="False"
                            Cursor="Hand"
                            MouseDown="SelectedFileText_MouseButtonDown"
                            Style="{StaticResource SubTitleStyle}"
                            Text="{Binding SelectedFileText}" />
                    </StackPanel>
                </Grid>

                <Grid
                    Grid.Row="2"
                    Margin="20,5,20,0"
                    ClipToBounds="False">

                    <ListBox ItemContainerStyle="{StaticResource CleanListBoxItemStyle}" ItemsSource="{Binding FileLockCards}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <cards:MultipurposeActionCardUserControl />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <TextBlock
                    Grid.Row="3"
                    Margin="0,0,0,40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource SubTitleStyle}"
                    Text="{Binding ProcessResult}"
                    TextWrapping="Wrap" />
            </Grid>

        </materialDesign:Card>


        <Grid Grid.Row="2">

            <!--#region Empty Folder State-->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Hidden" />

                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding FileLockCards.Count}" Value="0" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border
                    Width="140"
                    Height="140"
                    CornerRadius="30"
                    Style="{StaticResource GameBoostButtonCardBorderStyle}">

                    <materialDesign:PackIcon
                        Width="90"
                        Height="90"
                        Kind="FileFind"
                        Style="{StaticResource WatermarkStyle}" />
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource TitleStyle}"
                        Text="No process found" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubTitleStyle}"
                        Text="{Binding SelectedFileText, StringFormat='{}{0} is completely free from any active process', FallbackValue='File Name is completely free from any active process'}" />
                </StackPanel>
            </Grid>
            <!--#endregion-->
        </Grid>

        <Grid
            x:Name="DockRoot"
            Width="360"
            Height="70"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            ClipToBounds="False">
            <!--#region Dock Panel-->

            <Border
                Width="Auto"
                Height="Auto"
                Background="{StaticResource AppBackgroundColour}"
                CornerRadius="10" />

            <!--#region Dock Center-->
            <Border
                x:Name="DockCenter"
                Margin="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{StaticResource TitleBarBackgroundColour}"
                CornerRadius="8">

                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button
                        Command="{Binding LocateCommand}"
                        Content="Locate"
                        Style="{StaticResource DockActionButtonStyle}"
                        Tag="FileSearch"
                        ToolTip="Open the file in the file explorer" />

                    <Button
                        Command="{Binding EndAllProcessesCommand}"
                        Content="End All"
                        Style="{StaticResource DockActionButtonStyle}"
                        Tag="ContainEnd"
                        ToolTip="Force all processes to end" />

                    <Button
                        Command="{Binding RefreshCommand}"
                        Content="Refresh"
                        Style="{StaticResource DockActionButtonStyle}"
                        Tag="Refresh" />

                    <Button
                        Command="{Binding CloseSelectedProcessCommand}"
                        Content="Close"
                        IsEnabled="{Binding CanRunProcessAction}"
                        Style="{StaticResource DockActionButtonStyle}"
                        Tag="WindowClose"
                        ToolTip="Ask the selected process to close normally" />

                    <Button
                        Command="{Binding EndSelectedProcessCommand}"
                        Content="End"
                        IsEnabled="{Binding CanRunProcessAction}"
                        Style="{StaticResource DockActionButtonStyle}"
                        Tag="Close"
                        ToolTip="Force end the selected process" />
                </StackPanel>

            </Border>
            <!--#endregion-->
        </Grid>

    </Grid>
</Window>
