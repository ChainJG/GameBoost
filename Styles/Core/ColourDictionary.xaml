<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Primary Panel Colours  -->
    <SolidColorBrush x:Key="PrimaryPanelColour">#18191F</SolidColorBrush>
    <SolidColorBrush x:Key="SecondaryPanelColour">#121316</SolidColorBrush>

    <SolidColorBrush x:Key="PlainTitleTextColor" Color="#EBEBEB" />
    <SolidColorBrush x:Key="PlainSubtitleTextColor" Color="#A0A0A0" />

    <!--  Icon Colours  -->
    <SolidColorBrush x:Key="IconKindColor" Color="#EDEDED" />

    <SolidColorBrush x:Key="RedColour" Color="#de1a1a" />
    <SolidColorBrush x:Key="GreenColour" Color="#77ED86" />

    <!--  Core status colours  -->
    <SolidColorBrush x:Key="SuccessColour" Color="#2ECC71" />
    <SolidColorBrush x:Key="RecommendedColour" Color="#2ECC71" />
    <SolidColorBrush x:Key="GoodColour" Color="#77ED86" />

    <SolidColorBrush x:Key="WarningColour" Color="#E67E22" />
    <SolidColorBrush x:Key="CautionColour" Color="#F1C40F" />

    <SolidColorBrush x:Key="ErrorColour" Color="#E74C3C" />
    <SolidColorBrush x:Key="DangerColour" Color="#C0392B" />
    <SolidColorBrush x:Key="CriticalColour" Color="#FF3B30" />

    <!--  Information / neutral states  -->
    <SolidColorBrush x:Key="InfoColour" Color="#3498DB" />
    <SolidColorBrush x:Key="NoticeColour" Color="#5DADE2" />
    <SolidColorBrush x:Key="UnknownColour" Color="#95A5A6" />
    <SolidColorBrush x:Key="DisabledColour" Color="#7F8C8D" />

    <!--  Gaming / premium accent options  -->
    <SolidColorBrush x:Key="BoostColour" Color="#9B59B6" />
    <SolidColorBrush x:Key="PerformanceColour" Color="#00D1FF" />
    <SolidColorBrush x:Key="OptimisedColour" Color="#1ABC9C" />

    <!--  Clean neutral card colours  -->
    <SolidColorBrush x:Key="CardBackgroundColour" Color="#1E2027" />
    <SolidColorBrush x:Key="CardBackgroundHoverColour" Color="#252833" />
    <SolidColorBrush x:Key="CardBackgroundSelectedColour" Color="#2A2E3A" />
    <SolidColorBrush x:Key="CardBorderColour" Color="#2C303A" />
    <SolidColorBrush x:Key="CardBorderHoverColour" Color="#3A4050" />

    <!--  Purpose-based card colours  -->
    <SolidColorBrush x:Key="RecommendedCardBackgroundColour" Color="#182820" />
    <SolidColorBrush x:Key="WarningCardBackgroundColour" Color="#2A2118" />
    <SolidColorBrush x:Key="ErrorCardBackgroundColour" Color="#2A1818" />
    <SolidColorBrush x:Key="NoticeCardBackgroundColour" Color="#171E2A" />
    <SolidColorBrush x:Key="InfoCardBackgroundColour" Color="#172230" />
    <SolidColorBrush x:Key="PerformanceCardBackgroundColour" Color="#102631" />

    <!--  Purpose-based borders  -->
    <SolidColorBrush x:Key="RecommendedCardBorderColour" Color="#2ECC71" />
    <SolidColorBrush x:Key="WarningCardBorderColour" Color="#E67E22" />
    <SolidColorBrush x:Key="NoticeCardBorderColour" Color="#5D7FA3" />
    <SolidColorBrush x:Key="ErrorCardBorderColour" Color="#E74C3C" />
    <SolidColorBrush x:Key="InfoCardBorderColour" Color="#3498DB" />
    <SolidColorBrush x:Key="PerformanceCardBorderColour" Color="#00D1FF" />

    <!--  Transparent status backgrounds  -->
    <SolidColorBrush x:Key="SuccessBackgroundColour" Color="#202ECC71" />
    <SolidColorBrush x:Key="WarningBackgroundColour" Color="#20E67E22" />
    <SolidColorBrush x:Key="ErrorBackgroundColour" Color="#20E74C3C" />
    <SolidColorBrush x:Key="InfoBackgroundColour" Color="#203498DB" />

    <!--  Buttons Colours  -->
    <SolidColorBrush x:Key="ButtonBackground">#10FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonBorderColour">#20FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonMouseOver">#20FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonIsChecked">#30FFFFFF</SolidColorBrush>

    <SolidColorBrush x:Key="Transparent" Color="Transparent" />

</ResourceDictionary>




