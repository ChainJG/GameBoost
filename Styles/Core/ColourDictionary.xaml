<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--#region Core Application Surfaces-->

    <!--  Main app backgrounds  -->
    <SolidColorBrush x:Key="AppBackgroundColour" Color="#15171E" />
    <SolidColorBrush x:Key="PrimaryPanelColour" Color="#111217" />
    <SolidColorBrush x:Key="SecondaryPanelColour" Color="#0D0E12" />
    <SolidColorBrush x:Key="TertiaryPanelColour" Color="#1A1C24" />
    <SolidColorBrush x:Key="OverlayPanelColour" Color="#252834" />


    <!--  Window / page containers  -->
    <SolidColorBrush x:Key="WindowBackgroundColour" Color="#070709" />
    <SolidColorBrush x:Key="PageBackgroundColour" Color="#0B0C10" />
    <SolidColorBrush x:Key="PanelBorderColour" Color="#2B2D36" />
    <SolidColorBrush x:Key="PanelDividerColour" Color="#20222B" />

    <!--#endregion-->


    <!--#region Title Bar Colours-->

    <SolidColorBrush x:Key="TitleBarBackgroundColour" Color="#101116" />
    <SolidColorBrush x:Key="TitleBarBorderColour" Color="#18191F" />

    <SolidColorBrush x:Key="TitleBarForegroundColour" Color="#F2F3F5" />
    <SolidColorBrush x:Key="TitleBarSubtleForegroundColour" Color="#B5BAC1" />

    <SolidColorBrush x:Key="TitleBarButtonBackgroundColour" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="TitleBarButtonHoverBackgroundColour" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="TitleBarButtonPressedBackgroundColour" Color="#28FFFFFF" />

    <SolidColorBrush x:Key="TitleBarCloseButtonHoverBackgroundColour" Color="#DA373C" />
    <SolidColorBrush x:Key="TitleBarCloseButtonPressedBackgroundColour" Color="#B82C31" />
    <SolidColorBrush x:Key="TitleBarCloseButtonForegroundColour" Color="#FFFFFF" />

    <!--#endregion-->


    <!--#region Text Colours-->

    <!--  Primary text  -->
    <SolidColorBrush x:Key="MainForeground" Color="#F2F3F5" />
    <SolidColorBrush x:Key="PlainTitleTextColor" Color="#F2F3F5" />
    <SolidColorBrush x:Key="TextPrimaryColour" Color="#F2F3F5" />

    <!--  Secondary text  -->
    <SolidColorBrush x:Key="PlainSubtitleTextColor" Color="#B5BAC1" />
    <SolidColorBrush x:Key="TextSecondaryColour" Color="#B5BAC1" />

    <!--  Muted text  -->
    <SolidColorBrush x:Key="TextMutedColour" Color="#8B929D" />
    <SolidColorBrush x:Key="TextDisabledColour" Color="#5F6672" />

    <!--  Button text compatibility  -->
    <SolidColorBrush x:Key="ButtonTitleColor" Color="#F2F3F5" />
    <SolidColorBrush x:Key="ButtonSubTitleColor" Color="#B5BAC1" />

    <!--  Inverted text  -->
    <SolidColorBrush x:Key="TextOnAccentColour" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextOnDarkAccentColour" Color="#FFFFFF" />

    <!--#endregion-->


    <!--#region Brand / Accent Colours-->

    <!--  Discord-inspired primary accent  -->
    <SolidColorBrush x:Key="AccentColour" Color="#5865F2" />
    <SolidColorBrush x:Key="AccentHoverColour" Color="#6D78FF" />
    <SolidColorBrush x:Key="AccentPressedColour" Color="#4752C4" />
    <SolidColorBrush x:Key="AccentMutedColour" Color="#747BC7" />

    <!--  GameBoost performance accents  -->
    <SolidColorBrush x:Key="BoostColour" Color="#9B6DFF" />
    <SolidColorBrush x:Key="BoostHoverColour" Color="#B28CFF" />
    <SolidColorBrush x:Key="PerformanceColour" Color="#00C8FF" />
    <SolidColorBrush x:Key="OptimisedColour" Color="#23A559" />

    <!--#endregion-->


    <!--#region Icon Colours-->

    <SolidColorBrush x:Key="IconKindColor" Color="#DBDEE1" />
    <SolidColorBrush x:Key="IconMutedColour" Color="#949BA4" />
    <SolidColorBrush x:Key="IconDisabledColour" Color="#5F6672" />
    <SolidColorBrush x:Key="IconAccentColour" Color="#5865F2" />

    <!--#endregion-->


    <!--#region Core Status Colours-->

    <!--  Success / good  -->
    <SolidColorBrush x:Key="SuccessColour" Color="#23A559" />
    <SolidColorBrush x:Key="RecommendedColour" Color="#23A559" />
    <SolidColorBrush x:Key="GoodColour" Color="#57F287" />
    <SolidColorBrush x:Key="OptimisedStatusColour" Color="#10B981" />

    <!--  Warning / caution  -->
    <SolidColorBrush x:Key="WarningColour" Color="#F0B232" />
    <SolidColorBrush x:Key="CautionColour" Color="#FEE75C" />

    <!--  Error / danger  -->
    <SolidColorBrush x:Key="ErrorColour" Color="#F23F43" />
    <SolidColorBrush x:Key="DangerColour" Color="#DA373C" />
    <SolidColorBrush x:Key="CriticalColour" Color="#FF5C5C" />

    <!--  Info / neutral  -->
    <SolidColorBrush x:Key="InfoColour" Color="#5865F2" />
    <SolidColorBrush x:Key="NoticeColour" Color="#60A5FA" />
    <SolidColorBrush x:Key="UnknownColour" Color="#A3AAB8" />
    <SolidColorBrush x:Key="DisabledColour" Color="#7D8590" />

    <!--  Compatibility names  -->
    <SolidColorBrush x:Key="RedColour" Color="#F23F43" />
    <SolidColorBrush x:Key="GreenColour" Color="#57F287" />

    <!--#endregion-->


    <!--#region Status Background Overlays-->

    <SolidColorBrush x:Key="SuccessBackgroundColour" Color="#2023A559" />
    <SolidColorBrush x:Key="RecommendedBackgroundColour" Color="#2023A559" />
    <SolidColorBrush x:Key="WarningBackgroundColour" Color="#25F0B232" />
    <SolidColorBrush x:Key="CautionBackgroundColour" Color="#25FEE75C" />
    <SolidColorBrush x:Key="ErrorBackgroundColour" Color="#25F23F43" />
    <SolidColorBrush x:Key="DangerBackgroundColour" Color="#25DA373C" />
    <SolidColorBrush x:Key="InfoBackgroundColour" Color="#255865F2" />
    <SolidColorBrush x:Key="NoticeBackgroundColour" Color="#2560A5FA" />
    <SolidColorBrush x:Key="PerformanceBackgroundColour" Color="#2500C8FF" />
    <SolidColorBrush x:Key="BoostBackgroundColour" Color="#259B6DFF" />

    <!--#endregion-->


    <!--#region Card Colours-->

    <!--  Neutral cards  -->
    <SolidColorBrush x:Key="CardBackgroundColour" Color="#171921" />
    <SolidColorBrush x:Key="CardBackgroundHoverColour" Color="#202331" />
    <SolidColorBrush x:Key="CardBackgroundPressedColour" Color="#101218" />
    <SolidColorBrush x:Key="CardBackgroundSelectedColour" Color="#262B45" />

    <SolidColorBrush x:Key="CardBorderColour" Color="#2B2D36" />
    <SolidColorBrush x:Key="CardBorderHoverColour" Color="#3C4254" />
    <SolidColorBrush x:Key="CardBorderSelectedColour" Color="#5865F2" />

    <!--  Purpose-based card backgrounds  -->
    <SolidColorBrush x:Key="ActionRunningBackgroundColour" Color="#112838" />
    <SolidColorBrush x:Key="RecommendedCardBackgroundColour" Color="#14241B" />
    <SolidColorBrush x:Key="SuccessCardBackgroundColour" Color="#14241B" />
    <SolidColorBrush x:Key="WarningCardBackgroundColour" Color="#2E2413" />
    <SolidColorBrush x:Key="CautionCardBackgroundColour" Color="#302B14" />
    <SolidColorBrush x:Key="ErrorCardBackgroundColour" Color="#2F171B" />
    <SolidColorBrush x:Key="NoticeCardBackgroundColour" Color="#172336" />
    <SolidColorBrush x:Key="InfoCardBackgroundColour" Color="#1B1F3F" />
    <SolidColorBrush x:Key="PerformanceCardBackgroundColour" Color="#102938" />
    <SolidColorBrush x:Key="BoostCardBackgroundColour" Color="#241B3A" />
    <SolidColorBrush x:Key="DisabledCardBackgroundColour" Color="#17191F" />

    <!--  Purpose-based card borders  -->
    <SolidColorBrush x:Key="RecommendedCardBorderColour" Color="#23A559" />
    <SolidColorBrush x:Key="ActionRunningBorderColour" Color="#00C8FF" />
    <SolidColorBrush x:Key="SuccessCardBorderColour" Color="#23A559" />
    <SolidColorBrush x:Key="WarningCardBorderColour" Color="#F0B232" />
    <SolidColorBrush x:Key="CautionCardBorderColour" Color="#FEE75C" />
    <SolidColorBrush x:Key="NoticeCardBorderColour" Color="#60A5FA" />
    <SolidColorBrush x:Key="ErrorCardBorderColour" Color="#F23F43" />
    <SolidColorBrush x:Key="InfoCardBorderColour" Color="#5865F2" />
    <SolidColorBrush x:Key="PerformanceCardBorderColour" Color="#00C8FF" />
    <SolidColorBrush x:Key="BoostCardBorderColour" Color="#9B6DFF" />
    <SolidColorBrush x:Key="DisabledCardBorderColour" Color="#3A3F4D" />

    <!--#endregion-->


    <!--#region Button Colours-->

    <!--  Default transparent glass button  -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="ButtonBorderColour" Color="#20FFFFFF" />
    <SolidColorBrush x:Key="ButtonMouseOver" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="ButtonPressedColour" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ButtonIsChecked" Color="#335865F2" />

    <!--  Strong primary button  -->
    <SolidColorBrush x:Key="PrimaryButtonBackground" Color="#5865F2" />
    <SolidColorBrush x:Key="PrimaryButtonMouseOver" Color="#6D78FF" />
    <SolidColorBrush x:Key="PrimaryButtonPressed" Color="#4752C4" />
    <SolidColorBrush x:Key="PrimaryButtonBorderColour" Color="#8B95FF" />
    <SolidColorBrush x:Key="PrimaryButtonForeground" Color="#FFFFFF" />

    <!--  Secondary button  -->
    <SolidColorBrush x:Key="SecondaryButtonBackground" Color="#1E2029" />
    <SolidColorBrush x:Key="SecondaryButtonMouseOver" Color="#282C3A" />
    <SolidColorBrush x:Key="SecondaryButtonPressed" Color="#151820" />
    <SolidColorBrush x:Key="SecondaryButtonBorderColour" Color="#3C4254" />
    <SolidColorBrush x:Key="SecondaryButtonForeground" Color="#F2F3F5" />

    <!--  Danger button  -->
    <SolidColorBrush x:Key="DangerButtonBackground" Color="#2F171B" />
    <SolidColorBrush x:Key="DangerButtonMouseOver" Color="#421F25" />
    <SolidColorBrush x:Key="DangerButtonPressed" Color="#221014" />
    <SolidColorBrush x:Key="DangerButtonBorderColour" Color="#F23F43" />
    <SolidColorBrush x:Key="DangerButtonForeground" Color="#FFFFFF" />

    <!--  Success button  -->
    <SolidColorBrush x:Key="SuccessButtonBackground" Color="#14241B" />
    <SolidColorBrush x:Key="SuccessButtonMouseOver" Color="#1B3325" />
    <SolidColorBrush x:Key="SuccessButtonPressed" Color="#0E1A13" />
    <SolidColorBrush x:Key="SuccessButtonBorderColour" Color="#23A559" />
    <SolidColorBrush x:Key="SuccessButtonForeground" Color="#FFFFFF" />

    <!--  Disabled button  -->
    <SolidColorBrush x:Key="ButtonDisabledBackground" Color="#101116" />
    <SolidColorBrush x:Key="ButtonDisabledBorderColour" Color="#2B2D36" />
    <SolidColorBrush x:Key="ButtonDisabledForeground" Color="#5F6672" />

    <!--#endregion-->


    <!--#region Category / Chip Colours-->

    <SolidColorBrush x:Key="ChipBackgroundColour" Color="#0F1117" />
    <SolidColorBrush x:Key="ChipBorderColour" Color="#2B2D36" />
    <SolidColorBrush x:Key="ChipForegroundColour" Color="#B5BAC1" />

    <SolidColorBrush x:Key="ChipHoverBackgroundColour" Color="#1E2029" />
    <SolidColorBrush x:Key="ChipHoverBorderColour" Color="#3C4254" />
    <SolidColorBrush x:Key="ChipHoverForegroundColour" Color="#F2F3F5" />

    <SolidColorBrush x:Key="ChipSelectedBackgroundColour" Color="#1B1F3F" />
    <SolidColorBrush x:Key="ChipSelectedBorderColour" Color="#5865F2" />
    <SolidColorBrush x:Key="ChipSelectedForegroundColour" Color="#FFFFFF" />

    <!--#endregion-->


    <!--#region Input Colours-->

    <SolidColorBrush x:Key="InputBackgroundColour" Color="#0F1117" />
    <SolidColorBrush x:Key="InputBorderColour" Color="#2B2D36" />
    <SolidColorBrush x:Key="InputBorderHoverColour" Color="#3C4254" />
    <SolidColorBrush x:Key="InputBorderFocusedColour" Color="#5865F2" />
    <SolidColorBrush x:Key="InputForegroundColour" Color="#F2F3F5" />
    <SolidColorBrush x:Key="InputPlaceholderColour" Color="#8B929D" />
    <SolidColorBrush x:Key="InputSelectionColour" Color="#555865F2" />

    <!--#endregion-->


    <!--#region Progress / Loading Colours-->

    <SolidColorBrush x:Key="ProgressTrackColour" Color="#1E2029" />
    <SolidColorBrush x:Key="ProgressFillColour" Color="#5865F2" />

    <SolidColorBrush x:Key="ProgressTrackHoverColour" Color="#282C3A" />
    <SolidColorBrush x:Key="ProgressBorderHoverColour" Color="#3C4254" />

    <SolidColorBrush x:Key="LoadingSpinnerColour" Color="#5865F2" />

    <!--#endregion-->


    <!--#region Navigation Colours-->

    <SolidColorBrush x:Key="NavigationItemBackgroundColour" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="NavigationItemHoverBackgroundColour" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="NavigationItemSelectedBackgroundColour" Color="#225865F2" />
    <SolidColorBrush x:Key="NavigationItemSelectedBorderColour" Color="#5865F2" />

    <SolidColorBrush x:Key="NavigationForegroundColour" Color="#B5BAC1" />
    <SolidColorBrush x:Key="NavigationHoverForegroundColour" Color="#F2F3F5" />
    <SolidColorBrush x:Key="NavigationSelectedForegroundColour" Color="#FFFFFF" />

    <!--#endregion-->


    <!--#region Tooltip Colours-->

    <SolidColorBrush x:Key="ToolTipBackgroundColour" Color="#1E2029" />
    <SolidColorBrush x:Key="ToolTipBorderColour" Color="#3C4254" />

    <!--#endregion-->


    <!--#region Separator / Shadow / Overlay Colours-->

    <SolidColorBrush x:Key="SeparatorColour" Color="#20222B" />
    <SolidColorBrush x:Key="SubtleSeparatorColour" Color="#151820" />

    <SolidColorBrush x:Key="ModalOverlayColour" Color="#AA000000" />
    <SolidColorBrush x:Key="SoftOverlayColour" Color="#66000000" />

    <!--#endregion-->

</ResourceDictionary>