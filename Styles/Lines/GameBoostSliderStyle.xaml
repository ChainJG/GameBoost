<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Invisible repeat button used by the Slider track.  -->
    <Style x:Key="GameBoostSliderTrackButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--  Clean Windows 11-style Slider thumb.  -->
    <Style x:Key="GameBoostSliderThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Cursor" Value="Hand" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">

                    <Canvas ClipToBounds="False">

                        <Grid
                            Canvas.Left="-60"
                            Canvas.Top="-36"
                            Width="138"
                            Height="25">

                            <Border
                                x:Name="ValueBadge"
                                Height="25"
                                MinWidth="25"
                                Padding="8,0"
                                HorizontalAlignment="Center"
                                Background="{StaticResource SecondaryPanelColour}"
                                CornerRadius="12.5"
                                IsHitTestVisible="False"
                                Opacity="0">

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ButtonSubTitleStyle}"
                                    Text="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}" />

                            </Border>
                        </Grid>

                        <Canvas
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            ClipToBounds="False">

                            <!--  Soft glow behind the thumb.  -->
                            <Ellipse
                                x:Name="OuterGlow"
                                Canvas.Left="0"
                                Canvas.Top="0"
                                Width="18"
                                Height="18"
                                Fill="{StaticResource ButtonMouseOver}"
                                Opacity="1" />

                            <!--  Main slider handle.  -->
                            <Ellipse
                                x:Name="ThumbCircle"
                                Canvas.Left="3"
                                Canvas.Top="3"
                                Width="12"
                                Height="12"
                                Fill="{StaticResource ButtonIsChecked}" />

                        </Canvas>
                    </Canvas>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ValueBadge" Property="Opacity" Value="1" />
                            <Setter TargetName="OuterGlow" Property="Opacity" Value="0.45" />
                            <Setter TargetName="ThumbCircle" Property="Width" Value="14" />
                            <Setter TargetName="ThumbCircle" Property="Height" Value="14" />
                            <Setter TargetName="ThumbCircle" Property="Canvas.Left" Value="2" />
                            <Setter TargetName="ThumbCircle" Property="Canvas.Top" Value="2" />
                        </Trigger>

                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ValueBadge" Property="Opacity" Value="1" />
                            <Setter TargetName="OuterGlow" Property="Opacity" Value="0.65" />
                            <Setter TargetName="ThumbCircle" Property="Width" Value="15" />
                            <Setter TargetName="ThumbCircle" Property="Height" Value="15" />
                            <Setter TargetName="ThumbCircle" Property="Canvas.Left" Value="1.5" />
                            <Setter TargetName="ThumbCircle" Property="Canvas.Top" Value="1.5" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Filled part of the Slider track.  -->
    <Style x:Key="GameBoostSliderDecreaseTrackStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Command" Value="Slider.DecreaseLarge" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border
                        Height="8"
                        VerticalAlignment="Center"
                        Background="{StaticResource ButtonIsChecked}"
                        CornerRadius="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Empty part of the Slider track.  -->
    <Style x:Key="GameBoostSliderIncreaseTrackStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Command" Value="Slider.IncreaseLarge" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border
                        Height="7"
                        VerticalAlignment="Center"
                        Background="{StaticResource ButtonBackground}"
                        CornerRadius="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Main GameBoost Slider style.  -->
    <Style x:Key="GameBoostSliderStyle" TargetType="{x:Type Slider}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="TickFrequency" Value="1" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid Height="{TemplateBinding Height}" VerticalAlignment="Center">

                        <Track
                            x:Name="PART_Track"
                            IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                            Maximum="{TemplateBinding Maximum}"
                            Minimum="{TemplateBinding Minimum}"
                            Value="{TemplateBinding Value}">

                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource GameBoostSliderDecreaseTrackStyle}" />
                            </Track.DecreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb Style="{StaticResource GameBoostSliderThumbStyle}" />
                            </Track.Thumb>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource GameBoostSliderIncreaseTrackStyle}" />
                            </Track.IncreaseRepeatButton>

                        </Track>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>