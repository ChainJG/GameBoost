<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Invisible repeat button used by the Slider track.  -->
    <Style x:Key="GameBoostSliderTrackButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Clean Windows 11-style Slider thumb.  -->
    <Style x:Key="GameBoostSliderThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">

                    <Grid
                        Width="18"
                        Height="18"
                        ClipToBounds="False">

                        <!--  Value label that follows the slider handle.  -->
                        <Border
                            x:Name="ValueBadge"
                            Height="25"
                            MinWidth="25"
                            Margin="-10,-34,-10,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Background="{StaticResource SecondaryPanelColour}"
                            CornerRadius="25"
                            IsHitTestVisible="False"
                            Opacity="0">

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource GreenColour}"
                                Style="{StaticResource ButtonSubTitleStyle}"
                                Text="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}" />

                        </Border>

                        <!--  Soft glow behind the thumb.  -->
                        <Ellipse
                            x:Name="OuterGlow"
                            Width="18"
                            Height="18"
                            Fill="{StaticResource GreenColour}"
                            Opacity="0.25" />

                        <!--  Main slider handle.  -->
                        <Ellipse
                            x:Name="ThumbCircle"
                            Width="12"
                            Height="12"
                            Fill="{StaticResource GreenColour}" />

                    </Grid>

                    <ControlTemplate.Triggers>

                        <!--  Show value when hovering the handle.  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ValueBadge" Property="Opacity" Value="1" />
                            <Setter TargetName="OuterGlow" Property="Opacity" Value="0.45" />
                            <Setter TargetName="ThumbCircle" Property="Width" Value="14" />
                            <Setter TargetName="ThumbCircle" Property="Height" Value="14" />
                        </Trigger>

                        <!--  Keep value visible while dragging.  -->
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ValueBadge" Property="Opacity" Value="1" />
                            <Setter TargetName="OuterGlow" Property="Opacity" Value="0.65" />
                            <Setter TargetName="ThumbCircle" Property="Width" Value="15" />
                            <Setter TargetName="ThumbCircle" Property="Height" Value="15" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Filled part of the Slider track.  -->
    <Style x:Key="GameBoostSliderDecreaseTrackStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Command" Value="Slider.DecreaseLarge" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border
                        Height="6"
                        VerticalAlignment="Center"
                        Background="{StaticResource GreenColour}"
                        CornerRadius="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Empty part of the Slider track.  -->
    <Style x:Key="GameBoostSliderIncreaseTrackStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Command" Value="Slider.IncreaseLarge" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border
                        Height="6"
                        VerticalAlignment="Center"
                        Background="{StaticResource ButtonMouseOver}"
                        CornerRadius="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Main GameBoost Slider style.  -->
    <Style x:Key="GameBoostSliderStyle" TargetType="{x:Type Slider}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="TickFrequency" Value="1" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource GreenColour}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid Height="{TemplateBinding Height}" VerticalAlignment="Center">

                        <Track
                            x:Name="PART_Track"
                            IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                            Maximum="{TemplateBinding Maximum}"
                            Minimum="{TemplateBinding Minimum}"
                            Value="{TemplateBinding Value}">

                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource GameBoostSliderDecreaseTrackStyle}" />
                            </Track.DecreaseRepeatButton>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource GameBoostSliderIncreaseTrackStyle}" />
                            </Track.IncreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb Style="{StaticResource GameBoostSliderThumbStyle}" />
                            </Track.Thumb>

                        </Track>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>