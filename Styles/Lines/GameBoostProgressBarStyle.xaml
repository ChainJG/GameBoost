<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:GameBoost.MVVM.AttachedProperties">

    <Style x:Key="GameBoostProgressBarStyle" TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="8" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{StaticResource ProgressFillColour}" />
        <Setter Property="Background" Value="{StaticResource ProgressTrackColour}" />
        <Setter Property="ui:CornerRadiusAssist.CornerRadius" Value="2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">

                    <Border
                        x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{Binding Path=(ui:CornerRadiusAssist.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">

                        <Grid
                            x:Name="ClipHost"
                            ClipToBounds="True"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">

                            <Grid.Clip>
                                <MultiBinding Converter="{StaticResource RoundedRectangleClipConverter}">
                                    <Binding ElementName="ClipHost" Path="ActualWidth" />
                                    <Binding ElementName="ClipHost" Path="ActualHeight" />
                                    <Binding Path="(ui:CornerRadiusAssist.CornerRadius)" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </Grid.Clip>

                            <Border
                                x:Name="ProgressFill"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Background="{TemplateBinding Foreground}"
                                Opacity="1"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">

                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                        <Binding ElementName="ClipHost" Path="ActualWidth" />
                                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.45" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>