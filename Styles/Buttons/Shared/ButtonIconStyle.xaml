<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attach="clr-namespace:GameBoost.MVVM.AttachedProperties"
    xmlns:behavour="clr-namespace:GameBoost.MVVM.Behaviors"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}">

        <Setter Property="attach:PackIconKindAssist.Kind" Value="QuestionMark" />
        <Setter Property="attach:PackIconKindAssist.Size" Value="15" />

        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource IconKindColor}" />

        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />

        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />

        <Setter Property="ToolTipService.Placement" Value="Bottom" />
        <Setter Property="ToolTipService.VerticalOffset" Value="6" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="2500" />
        <Setter Property="ToolTipService.ShowDuration" Value="5000" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Margin="0"
                        Padding="0"
                        attach:InteractiveCardAssist.NormalBackground="{TemplateBinding Background}"
                        attach:InteractiveCardAssist.NormalBorderBrush="{TemplateBinding BorderBrush}"
                        Style="{StaticResource GameBoostInteractiveButtonCardBorderStyle}">

                        <materialDesign:PackIcon
                            x:Name="Icon"
                            attach:PackIconKindAssist.Size="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(attach:PackIconKindAssist.Size)}"
                            Foreground="{TemplateBinding Foreground}"
                            IsHitTestVisible="False"
                            Kind="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(attach:PackIconKindAssist.Kind), FallbackValue='QuestionMark'}" />

                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource IconDisabledColour}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>