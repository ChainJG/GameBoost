<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:ui="clr-namespace:GameBoost.MVVM.AttachedProperties">

    <Style x:Key="SelectCategoryButton" TargetType="{x:Type Button}">

        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type Button}">

                    <!--  Base border  -->
                    <Border
                        x:Name="BaseBorder"
                        Margin="0"
                        Padding="5"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10">

                        <Grid>
                            <StackPanel
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">

                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="{Binding Path=(ui:PackIconKindAssist.Kind), RelativeSource={RelativeSource AncestorType=Button}, FallbackValue='QuestionMark'}" />

                                <TextBlock
                                    x:Name="DisplayNameText"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ButtonSubTitleStyle}"
                                    Text="{TemplateBinding Content}" />
                            </StackPanel>
                        </Grid>


                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BaseBorder" Property="Background" Value="{StaticResource ButtonMouseOver}" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False" />
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>