<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attach="clr-namespace:GameBoost.MVVM.AttachedProperties"
    xmlns:behaviors="clr-namespace:GameBoost.MVVM.Behaviors"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style x:Key="InteractiveIconButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="attach:PackIconKindAssist.Kind" Value="QuestionMark" />
        <Setter Property="attach:PackIconKindAssist.Size" Value="24" />

        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />

        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />

        <Setter Property="Panel.ZIndex" Value="100" />

        <Setter Property="Width" Value="70" />
        <Setter Property="Height" Value="70" />

        <Setter Property="Content" Value="Text" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Margin="0"
                        Padding="0"
                        attach:InteractiveCardAssist.DisabledBorderBrush="{TemplateBinding BorderBrush}"
                        attach:InteractiveCardAssist.NormalBackground="{TemplateBinding Background}"
                        attach:InteractiveCardAssist.NormalBorderBrush="{TemplateBinding BorderBrush}"
                        Style="{StaticResource GameBoostInteractiveButtonCardBorderStyle}">
                        <Grid>
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Vertical">

                                <materialDesign:PackIcon
                                    x:Name="Icon"
                                    attach:PackIconKindAssist.Size="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(attach:PackIconKindAssist.Size)}"
                                    behaviors:PulsePopBehavior.Duration=".5"
                                    behaviors:PulsePopBehavior.Overshoot="7"
                                    behaviors:PulsePopBehavior.ReplayOnChange="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMouseOver}"
                                    behaviors:PulsePopBehavior.StartScale=".4"
                                    Kind="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(attach:PackIconKindAssist.Kind), FallbackValue='QuestionMark'}" />

                                <TextBlock
                                    x:Name="LabelText"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource ButtonSubTitleStyle}"
                                    Text="{TemplateBinding Content}"
                                    Visibility="Visible" />
                            </StackPanel>
                        </Grid>
                    </Border>


                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="attach:PackIconKindAssist.Size" Value="35" />
                            <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource IconDisabledColour}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>