<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:GameBoost.MVVM.Behaviors"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style x:Key="InteractiveIconButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />

        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />

        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="IsHitTestVisible" Value="True" />
        <Setter Property="IsEnabled" Value="True" />

        <!--  Ensure the control is rendered above common overlays and the template passes hit-test/cursor settings through  -->
        <Setter Property="Panel.ZIndex" Value="100" />

        <Setter Property="Width" Value="70" />
        <Setter Property="Height" Value="70" />

        <Setter Property="Content" Value="Text" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="{TemplateBinding Background}"
                        Cursor="{TemplateBinding Cursor}"
                        IsHitTestVisible="{TemplateBinding IsHitTestVisible}">
                        <Grid>
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Vertical">

                                <materialDesign:PackIcon
                                    x:Name="Icon"
                                    Width="24"
                                    Height="24"
                                    behaviors:PulsePopBehavior.Duration=".5"
                                    behaviors:PulsePopBehavior.Overshoot="7"
                                    behaviors:PulsePopBehavior.ReplayOnChange="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMouseOver}"
                                    behaviors:PulsePopBehavior.StartScale=".4"
                                    Kind="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag, FallbackValue=QuestionMark, TargetNullValue=QuestionMark}" />

                                <TextBlock
                                    x:Name="LabelText"
                                    Margin="0,2.5,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource ButtonSubTitleStyle}"
                                    Text="{TemplateBinding Content}"
                                    Visibility="Visible" />
                            </StackPanel>
                        </Grid>
                    </Border>


                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>