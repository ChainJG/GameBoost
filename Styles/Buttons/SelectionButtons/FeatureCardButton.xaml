<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style
        x:Key="SelectionFeatureCardBorderStyle"
        BasedOn="{StaticResource GameBoostInfoCardBorderStyle}"
        TargetType="{x:Type Border}">

        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource ButtonMouseOver}" />

        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True">

                <Setter Property="BorderBrush" Value="{StaticResource ButtonIsChecked}" />
                <Setter Property="Background" Value="{StaticResource CardBackgroundSelectedColour}" />

            </DataTrigger>
        </Style.Triggers>

    </Style>
</ResourceDictionary>