<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style
        x:Key="SelectionResultCardBorderStyle"
        BasedOn="{StaticResource GameBoostBaseBorderStyle}"
        TargetType="{x:Type Border}">

        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />

        <Style.Triggers>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding State}" Value="Result" />
                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsMouseOver}" Value="True" />
                </MultiDataTrigger.Conditions>

                <Setter Property="Background" Value="{StaticResource ButtonMouseOver}" />
                <Setter Property="Cursor" Value="Hand" />

            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding State}" Value="Result" />
                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True" />
                </MultiDataTrigger.Conditions>

                <Setter Property="Background" Value="{StaticResource ButtonIsChecked}" />
            </MultiDataTrigger>

        </Style.Triggers>

    </Style>
</ResourceDictionary>