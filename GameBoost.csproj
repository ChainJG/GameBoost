<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	  
	<NeutralLanguage>en</NeutralLanguage>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationManifest>GameBoost.manifest</ApplicationManifest>
	<PlatformTarget>x64</PlatformTarget>

	<PublishSingleFile>true</PublishSingleFile>
	<SelfContained>true</SelfContained>
	<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	<IncludeNativeLibrariesInSingleFile>true</IncludeNativeLibrariesInSingleFile>
	<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

	<Version>1.0.0</Version>
	<AssemblyVersion>1.0.0</AssemblyVersion>
	<FileVersion>1.0.0</FileVersion>

	<CopyRetryCount>20</CopyRetryCount>
	<CopyRetryDelayMilliseconds>50</CopyRetryDelayMilliseconds>
	  
	<ApplicationIcon>Assets\Icons\GameBoost.ico</ApplicationIcon>
  </PropertyGroup>
	
  <ItemGroup>
    <Compile Remove="Core\Servies\**" />
    <EmbeddedResource Remove="Core\Servies\**" />
    <None Remove="Core\Servies\**" />
    <Page Remove="Core\Servies\**" />
  </ItemGroup>
	
  <ItemGroup>
    <None Remove="Assets\Icons\GameBoost.ico" />
    <None Remove="Assets\Images\1024_GameBoost_Logo.png" />
    <None Remove="Assets\Images\1024_GameBoost_Logo_Default.png" />
  </ItemGroup>
	
  <ItemGroup>
    <Content Include="Assets\Icons\GameBoost.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Images\1024_GameBoost_Logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Images\1024_GameBoost_Logo_Default.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
		<PackageReference Include="System.Management" Version="10.0.8" />
		<PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.8" />
	</ItemGroup>
	
  <ItemGroup>
    <Folder Include="Features\Storage\Options\" />
  </ItemGroup>

</Project>
